# Copy to .env on the server (never commit .env). All secrets below are placeholders.
APP_NAME="Bilyart"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://itcode.uz
APP_TIMEZONE=UTC

APP_LOCALE=uz
APP_FALLBACK_LOCALE=uz
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info

# mysql | mariadb | pgsql (see docs/ARCHITECTURE.md §2a)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_TABLE=web_sessions
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# First Super Admin (used once by `php artisan db:seed`; remove the password afterwards)
SUPER_ADMIN_LOGIN=
SUPER_ADMIN_PASSWORD=

# Devices (docs/DEVICE_PROTOCOL.md)
DEVICE_TRANSPORT=http
DEVICE_REGISTRATION_SECRET=
DEVICE_ONLINE_TIMEOUT_SEC=15
DEVICE_START_MAX_LAST_SEEN_SEC=20
DEVICE_POLL_INTERVAL_SEC=3

# Photos
PHOTO_RETENTION_DEFAULT_DAYS=30

# Telegram
TELEGRAM_WEBHOOK_BASE_URL=https://itcode.uz

# Health details token (optional, for external monitors)
HEALTH_TOKEN=

# Backups (docs/BACKUP.md)
# base64 of 32 random bytes; keep a copy outside the server — without it backups cannot be restored
BACKUP_ENCRYPTION_KEY=
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_PHOTOS=4
