# Copied by Vite into the build (public/admin/.htaccess on the server).
# Static admin PWA files: strict CSP (same value as config/security.php 'csp.admin').
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

    # Hashed bundles never change; the shell, manifest and service worker must always be revalidated.
    <FilesMatch "^[\w.-]+-[\w-]{8,}\.(js|css|woff2?|png|svg|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest|workbox-[\w-]+\.js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
