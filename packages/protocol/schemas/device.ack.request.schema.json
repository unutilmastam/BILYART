{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://protocol.bilyart/device.ack.request.schema.json",
  "title": "DeviceAckRequest",
  "description": "POST /device/v1/ack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acks"
  ],
  "properties": {
    "acks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "title": "DeviceAck",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commandId",
          "result"
        ],
        "properties": {
          "commandId": {
            "$ref": "common.schema.json#/definitions/PublicId"
          },
          "result": {
            "type": "string",
            "enum": [
              "OK",
              "ERROR",
              "IGNORED"
            ]
          },
          "error": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "$ref": "common.schema.json#/definitions/LightState"
          },
          "channel": {
            "$ref": "common.schema.json#/definitions/Channel"
          }
        }
      }
    }
  }
}
