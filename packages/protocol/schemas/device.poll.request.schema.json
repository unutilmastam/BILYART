{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://protocol.bilyart/device.poll.request.schema.json",
  "title": "DevicePollRequest",
  "description": "POST /device/v1/poll — also the heartbeat. ts is the device clock (informational only). Tenant/branch/table are never accepted from the device.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ts", "fw", "state"],
  "properties": {
    "ts": { "$ref": "common.schema.json#/definitions/EpochSeconds" },
    "fw": { "$ref": "common.schema.json#/definitions/SemVer" },
    "state": { "$ref": "common.schema.json#/definitions/LightState" },
    "sessionId": { "oneOf": [{ "$ref": "common.schema.json#/definitions/PublicId" }, { "type": "null" }] },
    "endAt": { "oneOf": [{ "$ref": "common.schema.json#/definitions/EpochSeconds" }, { "type": "null" }] },
    "rssi": { "type": "integer", "minimum": -127, "maximum": 0 },
    "uptime": { "type": "integer", "minimum": 0 },
    "bootReason": { "type": "string", "maxLength": 32 },
    "lastAppliedCommandId": { "oneOf": [{ "$ref": "common.schema.json#/definitions/PublicId" }, { "type": "null" }] }
  }
}
