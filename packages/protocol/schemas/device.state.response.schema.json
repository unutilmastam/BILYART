{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://protocol.bilyart/device.state.response.schema.json",
  "title": "DeviceStateResponse",
  "description": "GET /device/v1/state — authoritative state after boot/reconnect (SYNC).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "serverTime",
    "sessions",
    "config"
  ],
  "properties": {
    "serverTime": {
      "$ref": "common.schema.json#/definitions/EpochSeconds"
    },
    "sessions": {
      "type": "array",
      "maxItems": 8,
      "description": "Running sessions of this device, at most one per channel.",
      "items": {
        "title": "DeviceStateSession",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel",
          "sessionId",
          "startAt",
          "endAt",
          "status"
        ],
        "properties": {
          "channel": {
            "$ref": "common.schema.json#/definitions/Channel"
          },
          "sessionId": {
            "$ref": "common.schema.json#/definitions/PublicId"
          },
          "startAt": {
            "$ref": "common.schema.json#/definitions/EpochSeconds"
          },
          "endAt": {
            "$ref": "common.schema.json#/definitions/EpochSeconds"
          },
          "status": {
            "type": "string",
            "enum": [
              "STARTING",
              "ACTIVE"
            ]
          }
        }
      }
    },
    "config": {
      "$ref": "device.command.schema.json#/definitions/DeviceConfig"
    }
  }
}
