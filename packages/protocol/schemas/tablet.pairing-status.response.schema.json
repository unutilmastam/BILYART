{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://protocol.bilyart/tablet.pairing-status.response.schema.json",
  "title": "TabletPairingStatusResponse",
  "description": "GET /api/tablet/pairing-status (Authorization: PollToken <pollToken>). token is returned exactly once.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "serverTime"],
  "properties": {
    "status": { "type": "string", "enum": ["WAITING", "PAIRED", "EXPIRED"] },
    "token": { "type": "string", "minLength": 32 },
    "serverTime": { "$ref": "common.schema.json#/definitions/IsoUtc" }
  }
}
