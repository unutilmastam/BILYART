{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://protocol.bilyart/tablet.register.request.schema.json",
  "title": "TabletRegisterRequest",
  "description": "POST /api/tablet/register (public, rate-limited). Starts tablet pairing; the code is shown on the tablet screen.",
  "type": "object",
  "additionalProperties": false,
  "required": ["appVersion"],
  "properties": {
    "appVersion": { "$ref": "common.schema.json#/definitions/SemVer" },
    "deviceModel": { "type": "string", "maxLength": 100 }
  }
}
