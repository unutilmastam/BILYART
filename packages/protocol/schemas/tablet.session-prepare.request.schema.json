{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://protocol.bilyart/tablet.session-prepare.request.schema.json",
  "title": "TabletSessionPrepareRequest",
  "description": "POST /api/tablet/sessions/prepare (Idempotency-Key required). Reserves the table for a short time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tableId", "durationMinutes"],
  "properties": {
    "tableId": { "$ref": "common.schema.json#/definitions/PublicId" },
    "durationMinutes": { "type": "integer", "minimum": 1, "maximum": 720 }
  }
}
